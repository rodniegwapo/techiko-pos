APP_NAME="Techiko POS"
APP_ENV=local
# /desktop/* login routes also load when APP_ENV=local (Laragon/local browser); staging/production require NativePHP or TEST_NATIVE_DESKTOP_ROUTES for PHPUnit.
APP_KEY=
APP_DEBUG=true
# Public site URL; used for canonical links, sitemap, Open Graph, and robots.
# Production: https://techiko-pos.com (no trailing slash).
APP_URL=http://localhost

# Optional: override canonical base URL for SeoController (sitemap <loc>, robots.txt Sitemap:).
# Leave empty if APP_URL is correct. Example production: APP_CANONICAL_URL=https://techiko-pos.com
APP_CANONICAL_URL=

#
# Production SEO checklist (after deploy): set APP_URL to HTTPS above; optionally APP_CANONICAL_URL.
# - Cloudflare CDN: disable or replace any robots.txt edge override so Laravel serves standard
#   lines (User-agent, Allow / Disallow, Sitemap:) — not only EU "content signals" comments.
# - Google Search Console: submit APP_URL/sitemap.xml, inspect /, request indexing; expect site:
#   results after crawl delay.

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=techiko_pos
DB_USERNAME=root
DB_PASSWORD=
# Dedicated SQLite file when RUNTIME_DB_SWITCH_ENABLED=true and the online probe fails.
# Migrate: php artisan migrate --database=offline_sqlite (see README "Offline SQLite").
DB_OFFLINE_DATABASE=

# --- Runtime DB switch (MySQL when online probe succeeds; else offline SQLite) ---
RUNTIME_DB_SWITCH_ENABLED=false
RUNTIME_DB_ONLINE_CONNECTION=mysql
RUNTIME_DB_OFFLINE_CONNECTION=offline_sqlite
# Blank = probe GET {APP_URL}/health from this codebase.
ONLINE_HEALTHCHECK_URL=
ONLINE_HEALTHCHECK_TIMEOUT_MS=2000
ONLINE_DB_CACHE_TTL_SECONDS=45
RUNTIME_DB_FORCE_ONLINE=false
RUNTIME_DB_FORCE_OFFLINE=false
# Set true when you need FORCE_* flags but APP_ENV is testing/staging without APP_DEBUG.
RUNTIME_DB_ALLOW_FORCE_FLAGS=false
# When RUNTIME_DB_SWITCH_ENABLED=true: prefer SESSION_DRIVER=file (recommended for offline-capable installs).
# If you use SESSION_DRIVER=database, set SESSION_CONNECTION to RUNTIME_DB_ONLINE_CONNECTION (e.g. mysql)
# or you may get 419 Page Expired on login (session writes following the flipped default DB).

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
# Pin when SESSION_DRIVER=database and RUNTIME_DB_SWITCH_ENABLED=true (match RUNTIME_DB_ONLINE_CONNECTION).
# SESSION_CONNECTION=mysql
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Forgot password emails use Laravel Password::sendResetLink. Production needs a working
# MAIL_* driver (SMTP, SES, Mailgun, Postmark, …). MAIL_MAILER=log only writes to log files.
# Set APP_URL to the public HTTPS site so reset links are correct.
# If QUEUE_CONNECTION is not sync, run a queue worker so queued mail is delivered.

# AWS S3 (Storage::disk('s3'); see config/filesystems.php)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Optional: public bucket base URL for Storage::url() when objects are readable
AWS_URL=
# Optional: LocalStack / MinIO / custom endpoint
AWS_ENDPOINT=
# Amazon S3: false (default). MinIO/LocalStack: often true and set AWS_ENDPOINT.
AWS_USE_PATH_STYLE_ENDPOINT=false
# If you see SignatureDoesNotMatch: key+secret must be from same IAM user, one line each unquoted; php artisan config:clear.

# Enable /dev/s3-upload-test outside local/development (default false). Requires auth + verified.
# FEATURE_S3_UPLOAD_TEST=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Laravel Licensing (masterix21/laravel-licensing) — enable ext-gmp in php.ini; run:
# php artisan licensing:keys:make-root
# php artisan licensing:keys:issue-signing --kid=your-key-id
LICENSING_KEY_PASSPHRASE=
# APP_URL — canonical public base URL for the app (reset links, Inertia Ziggy default, README examples).
# NativePHP/production desktop builds: prefer HTTPS production URL once deployed.
#
# LICENSING_SERVER_URL (config/licensing-client.php) — licensing API base URL for online validation.
# Defaults to APP_URL when unset. Point at production HTTPS licensing host when desktops must validate
# against the live licensing server (not a DB connection — MySQL stays server-side via DB_*).
LICENSING_SERVER_URL="${APP_URL}"
# Per-domain seat enforcement (optional middleware: license.domain)
LICENSING_ENFORCE_DOMAINS=false

# NativePHP desktop (com.example.techiko in production)
# NATIVEPHP_APP_ID=com.example.techikopos
# NATIVEPHP_APP_NAME="Techiko POS"

# Max rows for domains/vat-report/export (default 50000 in config/vat_report.php)
VAT_REPORT_MAX_EXPORT_ROWS=50000

# PayMongo (QR Ph servicing payments; register POST {PUBLIC_URL}/webhooks/paymongo in dashboard)
PAYMONGO_SECRET_KEY=

# Manual GCash reference UI + POST billing/servicing/manual-gcash (use sparingly when PayMongo unavailable)
MANUAL_BILLING_SHOW_MANUAL_GCASH=false

# Tier slug that uses bundled static QR (@assets/qrph_basic.jpg), not PayMongo Generate QR Ph
SERVICING_BASIC_TIER_SLUG=basic

PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Documentary URL for PayMongo webhook registration (tunnel or production HTTPS)
PAYMONGO_WEBHOOK_URL=
# Optional override (default https://api.paymongo.com/v1)
# PAYMONGO_API_BASE=

# UI visibility (default false = hidden). Set to true to show again without code changes.
# FEATURE_DOMAIN_SERVICING_SIDEBAR_VISIBLE=true
# FEATURE_MARKETING_PRICING_VISIBLE=true

# Product catalog caps (default true = unlimited; set false to enforce free tier / tier max_products)
# FEATURE_UNLIMITED_PRODUCTS=false

# Registration rate limits per IP (see config/registration.php). GET /register vs POST /register.
# REGISTRATION_PAGE_THROTTLE_PER_MINUTE=60
# REGISTRATION_SUBMIT_THROTTLE_PER_MINUTE=10
