APP_NAME="Techiko POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public site URL; used for canonical links, sitemap, Open Graph, and robots.
# Production: https://techiko-pos.com (no trailing slash).
APP_URL=http://localhost

# Optional: override canonical base URL for SeoController (sitemap <loc>, robots.txt Sitemap:).
# Leave empty if APP_URL is correct. Example production: APP_CANONICAL_URL=https://techiko-pos.com
APP_CANONICAL_URL=

#
# Production SEO checklist (after deploy): set APP_URL to HTTPS above; optionally APP_CANONICAL_URL.
# - Cloudflare CDN: disable or replace any robots.txt edge override so Laravel serves standard
#   lines (User-agent, Allow / Disallow, Sitemap:) — not only EU "content signals" comments.
# - Google Search Console: submit APP_URL/sitemap.xml, inspect /, request indexing; expect site:
#   results after crawl delay.

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=techiko_pos
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# Local: sync. Production: database and run a queue worker (railway/run-worker.sh) so verification mail is delivered.
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailgun SMTP (live). Username is the SMTP login from Mailgun, not the API key.
# If port 587 is blocked on the host, try MAIL_PORT=2525 with MAIL_ENCRYPTION=tls.
# Local only: MAIL_HOST=mailpit MAIL_PORT=1025 MAIL_ENCRYPTION=null MAIL_USERNAME=null MAIL_PASSWORD=null
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=rodnie@techiko-pos.com
MAIL_PASSWORD=your-mailgun-smtp-password
MAIL_FROM_ADDRESS="noreply@techiko-pos.com"
MAIL_FROM_NAME="${APP_NAME}"

# Forgot password emails use Laravel Password::sendResetLink. Production needs a working
# MAIL_* driver (SMTP, SES, Mailgun, Postmark, …). MAIL_MAILER=log only writes to log files.
# Set APP_URL to the public HTTPS site so reset links are correct.
# If QUEUE_CONNECTION is not sync, run a queue worker so queued mail is delivered.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Max rows for domains/vat-report/export (default 50000 in config/vat_report.php)
VAT_REPORT_MAX_EXPORT_ROWS=50000

# PayMongo (QR Ph servicing payments; register POST {PUBLIC_URL}/webhooks/paymongo in dashboard)
PAYMONGO_SECRET_KEY=

# Manual GCash reference UI + POST billing/servicing/manual-gcash (use sparingly when PayMongo unavailable)
MANUAL_BILLING_SHOW_MANUAL_GCASH=false

# Tier slug that uses bundled static QR (@assets/qrph_basic.jpg), not PayMongo Generate QR Ph
SERVICING_BASIC_TIER_SLUG=basic

PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Documentary URL for PayMongo webhook registration (tunnel or production HTTPS)
PAYMONGO_WEBHOOK_URL=
# Optional override (default https://api.paymongo.com/v1)
# PAYMONGO_API_BASE=

# UI visibility (default false = hidden). Set to true to show again without code changes.
# FEATURE_DOMAIN_SERVICING_SIDEBAR_VISIBLE=true
# FEATURE_MARKETING_PRICING_VISIBLE=true

# Product catalog caps (default true = unlimited; set false to enforce free tier / tier max_products)
# FEATURE_UNLIMITED_PRODUCTS=false

# Registration rate limits per IP (see config/registration.php). GET /register vs POST /register.
# REGISTRATION_PAGE_THROTTLE_PER_MINUTE=60
# REGISTRATION_SUBMIT_THROTTLE_PER_MINUTE=10

